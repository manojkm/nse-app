# Copy to .env and fill in your key.
# Get a key at https://indianapi.in/ (Indian Stock Market API).
# Leave it empty to run in demo mode with sample data.
ISE_API_KEY=

# Optional
ISE_API_BASE_URL=https://stock.indianapi.in
ISE_HTTP_HOST=127.0.0.1
ISE_HTTP_PORT=8000
ISE_REQUEST_TIMEOUT=30
# Seconds to cache identical API calls (saves your API quota). 0 disables.
ISE_CACHE_TTL=60
ISE_LOG_LEVEL=INFO
# Force demo data even when a key is set: 1 / true
ISE_DEMO_MODE=
